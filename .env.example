# ── App (public, bundled into the client) ─────────────────────────────
# These identify YOUR HALCYX backend. They are not secrets (RLS protects the data).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
EXPO_PUBLIC_GITHUB_APP_CLIENT_ID=Iv23liExampleClientId
EXPO_PUBLIC_GITHUB_APP_SLUG=halcyx
EXPO_PUBLIC_SENTRY_DSN=

# ── Build ─────────────────────────────────────────────────────────────
EAS_PROJECT_ID=
EAS_UPDATE_URL=https://u.expo.dev/your-eas-project-id
HALCYX_IOS_BUNDLE_ID=app.halcyx.mobile
HALCYX_ANDROID_PACKAGE=app.halcyx.mobile
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN is set as an EAS secret, never committed.

# Provider API keys are NOT configured here. Users add their own keys in the app;
# they are stored only on the device.
